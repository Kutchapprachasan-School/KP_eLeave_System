datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SupervisionStatus {
  SCHEDULED               // นัดหมายเรียบร้อย รอการนิเทศ
  WAITING_TEACHER_ACK     // ผู้นิเทศประเมินแล้ว รอครูรับทราบ/สะท้อนคิด
  WAITING_DIRECTOR_SIGN   // ครูรับทราบแล้ว รอ ผอ. ลงนามเห็นชอบ
  COMPLETED               // ผอ. ลงนามเสร็จสมบูรณ์
}

enum SupervisionType {
  ON_SITE        // นิเทศในห้องเรียนจริง
  ONLINE_VIDEO   // นิเทศออนไลน์ผ่านลิงก์ภายนอก (YouTube / Google Drive / OneDrive)
}

model SupervisionSession {
  id                  String             @id @default(cuid())
  schoolId            String
  academicYear        Int                // พ.ศ. เช่น 2569
  term                Int                // ภาคเรียน 1 หรือ 2
  
  // วิชาและตารางสอน
  subjectCode         String             // เช่น ว23101
  subjectName         String             // ชื่อวิชา
  gradeLevel          String             // เช่น ม.3/1
  departmentGroup     String             // กลุ่มสาระการเรียนรู้
  dayOfWeek           Int                // 1 = จันทร์, ..., 5 = ศุกร์
  periodNumber        Int                // คาบที่ 1 - 8
  scheduledDate       DateTime

  // บุคลากร
  teacherId           String             // ID ครูผู้รับการนิเทศ
  teacherName         String             // ชื่อครูผู้รับการนิเทศ
  supervisorId        String             // ID ผู้นิเทศ
  supervisorName      String             // ชื่อผู้นิเทศ
  
  // Anti-Bloat Artifacts
  type                SupervisionType    @default(ON_SITE)
  lessonPlanUrl       String?            // ไฟล์แผนการสอน PDF (< 10MB) 1 ไฟล์
  videoUrl            String?            // ลิงก์วิดีโอภายนอก ป้องกันดิสก์เต็ม
  
  // Dynamic Rubric Data (JSON Storage)
  rubricScores        Json?              // ประเมินตาม Schema ใน Domain
  totalScore          Float?             // คะแนนเฉลี่ย (1.00 - 5.00)
  supervisorComment   String?            @db.Text
  teacherReflection   String?            @db.Text // ข้อคิดเห็นสะท้อนคิดของครู
  
  // Phase 1 Approval & Signing
  directorSignedBy    String?            // User ID ของผู้อำนวยการผู้ลงนาม
  directorSignedAt    DateTime?
  directorComment     String?            @db.Text
  
  status              SupervisionStatus  @default(SCHEDULED)
  auditLogs           SupervisionAuditLog[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([schoolId, academicYear, term])
  @@index([teacherId, status])
  @@index([scheduledDate, dayOfWeek, periodNumber])
}

model SupervisionAuditLog {
  id          String             @id @default(cuid())
  sessionId   String
  session     SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actionBy    String             // User ID ของผู้ทำรายการ
  actionType  String             // DIRECTOR_SIGN / TEACHER_ACK / EVALUATE
  reason      String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([sessionId])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String   // e.g. SUPERVISION_SESSION
  aggregateId   String
  eventType     String   // e.g. SUPERVISION_COMPLETED
  payload       Json     // Strict Payload Validate จาก Domain Schema
  status        String   @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

// ==========================================
// SROP Phase 1 & Phase 2 Models
// ==========================================

enum TimetableVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentPolicyType {
  CENTRALIZED
  DEPARTMENT
  HYBRID
}

enum SubstituteWorkflowStatus {
  ASSIGNED
  ACKNOWLEDGED
  REJECTED
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  teachers    Teacher[]
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Teacher {
  id               String           @id @default(cuid())
  employeeCode     String           @unique
  prefix           String?
  firstName        String
  lastName         String
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id])
  maxWeeklyPeriods Int              @default(20)
  offerings        SubjectOffering[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Subject {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  credits      Float             @default(1.0)
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  offerings    SubjectOffering[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ClassRoom {
  id          String            @id @default(cuid())
  gradeLevel  Int               // e.g. 3 (ม.3)
  roomNumber  Int               // e.g. 1 (ห้อง 1)
  name        String            // e.g. "ม.3/1"
  offerings   SubjectOffering[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([gradeLevel, roomNumber])
}

model Room {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String          // e.g. "ห้องปฏิบัติการคอมพิวเตอร์ 1"
  building    String?         // e.g. "อาคาร 3"
  roomType    String          @default("REGULAR") // REGULAR, LAB, COMPUTER
  slots       TimetableSlot[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SubjectOffering {
  id           String          @id @default(cuid())
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  teacherId    String
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  classRoomId  String
  classRoom    ClassRoom       @relation(fields: [classRoomId], references: [id])
  academicYear Int             // e.g. 2569
  term         Int             // e.g. 1
  slots        TimetableSlot[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([subjectId, teacherId, classRoomId, academicYear, term])
  @@index([academicYear, term])
}

model TimetableVersion {
  id                 String                 @id @default(cuid())
  schoolId           String
  academicYear       Int                    // e.g. 2569
  term               Int                    // e.g. 1
  versionName        String                 // e.g. "ตารางสอนภาคเรียนที่ 1/2569 ฉบับร่าง 1"
  status             TimetableVersionStatus @default(DRAFT)
  isCurrentPublished Boolean                @default(false)
  slots              TimetableSlot[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([schoolId, academicYear, term, status])
}

model TimetableSlot {
  id                 String              @id @default(cuid())
  timetableVersionId String
  timetableVersion   TimetableVersion    @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)
  offeringId         String
  offering           SubjectOffering     @relation(fields: [offeringId], references: [id])
  roomId             String
  room               Room                @relation(fields: [roomId], references: [id])
  dayOfWeek          Int                 // 1 = Monday, ..., 5 = Friday
  periodNumber       Int                 // 1..8
  recommendationRuns RecommendationRun[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([timetableVersionId, offeringId, dayOfWeek, periodNumber])
  @@unique([timetableVersionId, roomId, dayOfWeek, periodNumber])
}

model SchoolConfig {
  id               String               @id @default(cuid())
  schoolId         String               @unique
  assignmentPolicy AssignmentPolicyType @default(DEPARTMENT)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model SubstituteWorkflow {
  id                String                   @id @default(cuid())
  leaveRequestId    String
  timetableSlotId   String
  date              DateTime
  assignedTeacherId String
  assignedBy        String
  status            SubstituteWorkflowStatus @default(ASSIGNED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([leaveRequestId, date])
}

model RecommendationRun {
  id              String        @id @default(cuid())
  leaveRequestId  String
  timetableSlotId String
  policy          String
  candidatesJson  String
  createdAt       DateTime      @default(now())

  timetableSlot   TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@index([timetableSlotId])
}


