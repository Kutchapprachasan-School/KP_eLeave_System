// ─────────────────────────────────────────────────────────────────────────────
// 1. TEMPLATE VERSIONING (Immutable Master)
// ─────────────────────────────────────────────────────────────────────────────
model ExamTemplate {
  id                  String         @id @default(cuid())
  code                String         // e.g. "KP-OMR-A4-50"
  version             Int            // 1, 2, 3...
  name                String         // แบบฟอร์ม 50 ข้อ มาตรฐาน 2569
  sheetType           ExamSheetType  @default(SHEET_50_ITEMS)
  canvasWidth         Int            @default(1654)
  canvasHeight        Int            @default(2339)
  
  gridMetadata        Json           // Strict Schema: markers, bubbles, studentId
  calibrationDefaults Json           // Configurable CV Defaults
  
  isDeprecated        Boolean        @default(false)
  examPapers          ExamPaper[]
  createdAt           DateTime       @default(now())

  @@unique([code, version], map: "uk_exam_template_code_version")
  @@index([sheetType, isDeprecated])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. EXAM PAPER & PRINTED SHEET REGISTRY
// ─────────────────────────────────────────────────────────────────────────────
model ExamPaper {
  id                   String                 @id @default(cuid())
  subjectCode          String                 // e.g. "ว23101"
  subjectName          String                 // e.g. "วิทยาศาสตร์ 5"
  academicYear         Int                    // e.g. 2026
  term                 Int                    // 1 หรือ 2
  gradeLevel           String                 // e.g. "ม.3"
  title                String                 // e.g. "สอบกลางภาคเรียนที่ 1/2569"
  
  templateId           String
  template             ExamTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  
  totalItems           Int                    @default(50)
  maxScore             Decimal                @db.Decimal(6, 2)
  passScore            Decimal                @db.Decimal(6, 2)

  totalSubjectiveItems Int                    @default(0)
  subjectiveMaxScore   Decimal                @default(0.00) @db.Decimal(6, 2)
  
  createdById          String
  createdBy            User                   @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  
  isDeleted            Boolean                @default(false)
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?                  @relation("ExamDeletedByUser", fields: [deletedById], references: [id], onDelete: SetNull)
  purgeAt              DateTime?

  answerKeys           ExamAnswerKey[]
  keyVersions          ExamAnswerKeyVersion[]
  subjectiveItems      ExamSubjectiveItem[]
  printedSheets        ExamPrintedSheet[]
  submissions          ExamSubmission[]
  regradeJobs          ExamRegradeJob[]
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([subjectCode, academicYear, term])
  @@index([createdById, isDeleted])
  @@index([isDeleted, purgeAt])
}

model ExamSubjectiveItem {
  id           String     @id @default(cuid())
  examPaperId  String
  examPaper    ExamPaper  @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  itemNo       Int        // 1..totalSubjectiveItems
  title        String     // คำถาม / คำชี้แจง
  maxScore     Decimal    @db.Decimal(5, 2)
  rubricDetail String?    // เกณฑ์คะแนน
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([examPaperId, itemNo], map: "uk_subjective_item_paper_no")
  @@index([examPaperId])
}

model ExamAnswerKeyVersion {
  id          String     @id @default(cuid())
  examPaperId String
  examPaper   ExamPaper  @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  version     Int        // 1, 2, 3...
  keyPayload  Json       // Snapshot of answers [{ itemNo: 1, correctChoices: ["A"], points: 1.0 }, ...]
  totalItems  Int
  maxScore    Decimal    @db.Decimal(6, 2)
  changedById String
  changedBy   User       @relation("KeyVersionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime   @default(now())

  submissions ExamSubmission[]
  regradeJobs ExamRegradeJob[]

  @@unique([examPaperId, version], map: "uk_paper_key_version")
  @@index([examPaperId])
}

model ExamPrintedSheet {
  id              String         @id @default(cuid())
  sheetToken      String         @unique(map: "uk_printed_sheet_token") // Opaque CUID2
  examPaperId     String
  examPaper       ExamPaper      @relation(fields: [examPaperId], references: [id], onDelete: Restrict)
  
  studentId       String         // รหัสนักเรียน
  studentName     String?
  classroom       String?
  seatNo          Int?
  attemptNo       Int            @default(1)
  isUsed          Boolean        @default(false)
  usedAt          DateTime?
  
  createdAt       DateTime       @default(now())

  @@unique([examPaperId, studentId, attemptNo], map: "uk_printed_sheet_paper_student_attempt")
  @@index([sheetToken])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. ANSWER KEYS & NORMALIZED ITEMS
// ─────────────────────────────────────────────────────────────────────────────
model ExamAnswerKey {
  id              String               @id @default(cuid())
  examPaperId     String
  examPaper       ExamPaper            @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  versionCode     String               // e.g. "01", "02", "03", "04"
  items           ExamAnswerKeyItem[]
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([examPaperId, versionCode], map: "uk_answer_key_paper_version")
  @@index([examPaperId])
}

model ExamAnswerKeyItem {
  id              String            @id @default(cuid())
  answerKeyId     String
  answerKey       ExamAnswerKey     @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  itemNo          Int               // 1..totalItems (Validated via Trigger & Service)
  correctChoices  String[]          // Checked by cardinality() BETWEEN 1 AND 5
  points          Decimal           @default(1.00) @db.Decimal(5, 2)
  penaltyPoints   Decimal           @default(0.00) @db.Decimal(5, 2)
  
  @@unique([answerKeyId, itemNo], map: "uk_answer_key_item_no")
  @@index([answerKeyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. SUBMISSION ATTEMPTS & MATERIALIZED CACHE
// ─────────────────────────────────────────────────────────────────────────────
model ExamSubmission {
  id                  String               @id @default(cuid())
  clientScanId        String               @unique(map: "uk_submission_client_scan_id") // Idempotency Key
  examPaperId         String
  examPaper           ExamPaper            @relation(fields: [examPaperId], references: [id], onDelete: Restrict)
  
  studentId           String
  studentName         String?
  classroom           String?
  seatNo              Int?
  versionCode         String               @default("01")
  attemptNo           Int                  @default(1)
  isLatestAttempt     Boolean              @default(true)
  
  // ⚠️ DERIVED MATERIALIZED SNAPSHOT ONLY: Updated exclusively via recalculateSubmissionScore
  rawScore            Decimal              @db.Decimal(6, 2)
  subjectiveScore     Decimal              @default(0.00) @db.Decimal(6, 2)
  subjectiveScores    Json?                // Map of itemNo -> score
  netScore            Decimal              @db.Decimal(6, 2)
  totalCorrect        Int                  @default(0)
  totalIncorrect      Int                  @default(0)
  totalBlanks         Int                  @default(0)
  totalMultiple       Int                  @default(0)
  gradingVersion      Int                  @default(1)
  gradingVersionId    String?
  gradingKeyVersion   ExamAnswerKeyVersion? @relation(fields: [gradingVersionId], references: [id], onDelete: SetNull)
  
  confidenceAvg       Decimal              @db.Decimal(4, 3)
  hasAnomalies        Boolean              @default(false)
  isVerifiedByTeacher Boolean              @default(false)
  verifiedByUserId    String?
  verifiedAt          DateTime?
  
  scannedImageKey     String?              // Pure ASCII Storage Key
  syncStatus          SubmissionSyncStatus @default(SYNCED)

  // Raw Image Chain of Custody & Detection Metadata
  rawImageHash        String?              // SHA-256 of master original
  processedImageHash  String?              // SHA-256 of normalized perspective image
  rawStorageKey       String?              // Storage Key for WORM Archival Master
  processedStorageKey String?              // Storage Key for WebP Detection/Preview
  detectorVersion     String?              @default("REV_9.0_HYBRID")
  thresholdProfile    String?              @default("STANDARD_A4")
  ingestedAt          DateTime             @default(now())

  // Student Identity & Historical Snapshots
  studentCodeSnapshot String?
  classSnapshot       String?
  examRosterId        String?
  studentIdentityStatus StudentIdentityStatus @default(IDENTIFIED)
  mappingReason       String?
  
  itemSubmissions     ExamItemSubmission[]
  scannedAt           DateTime             @default(now())
  scannedByUserId     String
  scannedByUser       User                 @relation("ExamScannedBy", fields: [scannedByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Partial Unique Index: 1 Latest Attempt per student per exam
  @@unique([examPaperId, studentId], map: "uk_latest_submission_per_student", where: { isLatestAttempt: true })
  @@index([examPaperId, classroom])
  @@index([scannedByUserId])
  @@index([syncStatus])
  @@index([gradingVersionId])
  @@index([examPaperId, isLatestAttempt, createdAt, id], map: "ExamSubmission_paper_latest_created_id_idx")
}

// ⭐ SINGLE SOURCE OF TRUTH (Leaf Item Scores)
model ExamItemSubmission {
  id                  String             @id @default(cuid())
  submissionId        String
  submission          ExamSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemNo              Int
  
  detectedChoices     String[]
  fillRatios          Json
  confidenceScore     Decimal            @db.Decimal(4, 3)
  
  overrideVersion     Int                @default(0)
  detectionStatus     DetectionStatus    @default(SINGLE_MARK)
  overrideChoice      String?            // Manual Override by Teacher
  effectiveChoice     String?            // Source of Truth for recalculation
  isOverridden        Boolean            @default(false)
  
  isCorrect           Boolean            @default(false)
  scoreEarned         Decimal            @db.Decimal(4, 2) @default(0)
  status              ExamItemStatus     @default(CORRECT)

  overrides           ExamItemOverride[]

  @@unique([submissionId, itemNo], map: "uk_item_submission_item_no")
  @@index([submissionId])
}

model ExamItemOverride {
  id               String             @id @default(cuid())
  submissionItemId String
  submissionItem   ExamItemSubmission @relation(fields: [submissionItemId], references: [id], onDelete: Restrict)
  sequenceNo       BigInt
  previousChoice   String?
  overrideChoice   String
  reason           String             @db.Text
  actorUserId      String
  requestId        String
  createdAt        DateTime           @default(now())

  @@unique([submissionItemId, sequenceNo])
  @@index([submissionItemId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuditEvent {
  id                      String   @id @default(cuid())
  entityType              String
  entityId                String
  action                  String
  actorUserId             String
  actorNameSnapshot       String
  actorRoleSnapshot       String
  actorDepartmentSnapshot String?
  requestId               String
  correlationId           String
  source                  String   @default("WEB_PORTAL")
  previousState           Json?
  newState                Json?
  metadata                Json?
  createdAt               DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String            @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0)
  errorMessage  String?
  createdAt     DateTime          @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
}

enum StudentIdentityStatus {
  IDENTIFIED
  UNMAPPED
  AMBIGUOUS
  BLANK
  UNRESOLVED
  PHANTOM
}

enum DetectionStatus {
  SINGLE_MARK
  MULTIPLE_MARKS
  NO_MARK
  AMBIGUOUS
  LOW_CONFIDENCE
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. IMMUTABLE AUDIT LOG (100% PURE SNAPSHOT - NO FK COUPLING)
// ─────────────────────────────────────────────────────────────────────────────
model ExamAuditLog {
  id                   String       @id @default(cuid())
  examPaperIdSnapshot  String       // Pure Snapshot Scalar
  submissionIdSnapshot String?      // Pure Snapshot Scalar
  
  action               String       // "SCAN_INGEST", "MANUAL_OVERRIDE", "RECALCULATE_SCORES", "ANSWER_KEY_MUTATION", "PAPER_RESTORED"
  performedByUserId    String       // User ID Snapshot
  details              Json         // Diff / Snapshot details
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime     @default(now())

  @@index([examPaperIdSnapshot, createdAt], map: "idx_audit_paper_created")
  @@index([performedByUserId], map: "idx_audit_user")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. ASYNCHRONOUS REGRADE JOB & CONCURRENCY LEASE
// ─────────────────────────────────────────────────────────────────────────────
enum RegradeJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SUPERSEDED
}

model ExamRegradeJob {
  id                   String               @id @default(cuid())
  examPaperId          String
  examPaper            ExamPaper            @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  targetKeyVersionId   String
  targetKeyVersion     ExamAnswerKeyVersion @relation(fields: [targetKeyVersionId], references: [id], onDelete: Cascade)
  status               RegradeJobStatus     @default(PENDING)
  workerToken          String?
  leaseExpiresAt       DateTime?
  totalSubmissions     Int                  @default(0)
  processedSubmissions Int                  @default(0)
  snapshotEndCreatedAt DateTime?
  snapshotEndId        String?
  cursorCreatedAt      DateTime?
  cursorId             String?
  batchSize            Int                  @default(50)
  errorMessage         String?
  createdById          String?
  createdBy            User?                @relation("ExamRegradeJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([examPaperId, status])
}

// ============================================================================
// 🧑‍🤝‍🧑 STUDENT AFFAIRS FORENSIC CORE (REV 3.9)
// ============================================================================

enum StudentStatus {
  ACTIVE
  SUSPENDED
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED_OUT
  COMPLETED
  DROPPED
}

enum StudentDecommissionReason {
  DUPLICATE_RECORD_MERGE
  COURT_OR_LEGAL_ORDER
  DATA_MIGRATION_CLEANUP
  SYSTEM_DECOMMISSION
}

enum StudentGender {
  MALE
  FEMALE
}

enum ScheduledSessionType {
  REGULAR
  MAKEUP
  CANCELLED_HOLIDAY
  CANCELLED_TEACHER_DUTY
  CANCELLED_SCHOOL_EVENT
}

enum StudentAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  ACTIVITY
}

enum AttendanceExemptionStatus {
  NONE
  PENDING_REVIEW
  EXEMPTED_OFFICIAL
  REJECTED
}

enum BehaviorLedgerType {
  DEMERIT             // points < 0
  MERIT               // points > 0
  CORRECTION_CREDIT   // points > 0
  CORRECTION_DEBIT    // points < 0
}

enum BehaviorCategory {
  PUNCTUALITY
  DRESS_CODE
  ATTENDANCE
  SUBSTANCE_ABUSE
  VIOLENCE_BULLYING
  GAMBLING
  HONOR_INTEGRITY
  VOLUNTEER_MERIT
  ACADEMIC_EXCELLENCE
  SPECIAL_ACHIEVEMENT
  OTHER
}

enum EvaluatorType {
  TEACHER
  PARENT
  STUDENT
}

enum SdqLevel {
  NORMAL
  AT_RISK
  PROBLEM
}

enum CctPovertyLevel {
  EXTREMELY_POOR
  POOR
  NOT_POOR
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FOLLOW_UP
  RESOLVED
  CLOSED
  ESCALATED
  CANCELLED
}

enum CaseOutcome {
  PENDING
  IMPROVED
  STABLE
  WORSENED
}

enum RiskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NORMAL
}

enum NominationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ISSUED
}

enum AttachmentEntityType {
  HOME_VISIT
  BEHAVIOR_EVIDENCE
  CASE_DOC
}

enum AttachmentCategory {
  HOME_VISIT_FAMILY
  HOME_VISIT_HOUSE_EXTERIOR
  HOME_VISIT_HOUSE_INTERIOR
  BEHAVIOR_EVIDENCE
  CASE_INTERVENTION_DOCUMENT
}

enum CctManifestStatus {
  PENDING_UPLOAD
  VERIFIED
  FAILED
}

// -------------------------------------------------------------
// 1. Identity & Enrollment History (Atomic Status Guarded)
// -------------------------------------------------------------

model Student {
  id              String                     @id @default(cuid())
  studentCode     String                     @unique
  nationalId      String?
  title           String
  firstName       String
  lastName        String
  nickname        String?
  gender          StudentGender              @default(MALE)
  birthDate       DateTime?
  status          StudentStatus              @default(ACTIVE)
  
  homeAddress     String?
  parentName      String?
  parentPhone     String?
  
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?                      @relation("StudentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  deletionReason  StudentDecommissionReason?
  
  enrollments     StudentEnrollment[]
  statusHistories StudentStatusHistory[]
  behaviorRecords BehaviorRecord[]
  yearlyProjections StudentYearlyBehaviorProjection[]
  homeVisits      StudentHomeVisit[]
  sdqEvaluations  StudentSdqEvaluation[]
  riskAssessments StudentRiskAssessment[]
  interventionCases StudentInterventionCase[]
  certNominations StudentMeritNomination[]
  medicalCertificates StudentMedicalCertificate[]
  
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status])
  @@index([deletedAt])
}

model StudentStatusHistory {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fromStatus    StudentStatus
  toStatus      StudentStatus
  effectiveDate DateTime
  reason        String
  changedById   String
  changedBy     User          @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([studentId, effectiveDate])
}

model StudentEnrollment {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear Int
  term         Int              // CHECK IN (1, 2)
  classRoomId  String
  classRoom    ClassRoom        @relation(fields: [classRoomId], references: [id], onDelete: Restrict)
  gradeLevel   Int              // CHECK BETWEEN 1 AND 6
  roomNumber   Int              // CHECK >= 1
  rollNumber   Int              // CHECK >= 1
  status       EnrollmentStatus @default(ENROLLED)
  advisorId    String?
  advisor      User?            @relation("AdvisorEnrollments", fields: [advisorId], references: [id], onDelete: Restrict)
  
  morningAttendances StudentMorningAttendance[]
  periodAttendances  StudentPeriodAttendance[]
  riskAssessments    StudentRiskAssessment[]
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, academicYear, term], map: "uk_student_enrollment_term")
  @@index([academicYear, term, gradeLevel, roomNumber])
}

// -------------------------------------------------------------
// 2. Behavior Ledger & Projected Scores (Native Date & Clean Projection)
// -------------------------------------------------------------

model BehaviorRecord {
  id                  String             @id @default(cuid())
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear        Int
  sequenceNo          BigInt
  type                BehaviorLedgerType
  category            BehaviorCategory
  points              Int                // CHECK points != 0 & sign
  balanceAfter        Int
  
  businessDate        DateTime           @db.Date // Native PostgreSQL DATE
  incidentTimestamp   DateTime
  location            String?
  description         String
  
  correctionForId     String?            // Partial unique index uk_behavior_single_correction
  correctionFor       BehaviorRecord?    @relation("CorrectionRelation", fields: [correctionForId], references: [id], onDelete: Restrict)
  corrections         BehaviorRecord[]   @relation("CorrectionRelation")
  
  reportedById        String
  reportedBy          User               @relation(fields: [reportedById], references: [id], onDelete: Restrict)
  
  createdAt           DateTime           @default(now())

  @@unique([studentId, academicYear, sequenceNo], map: "uk_student_behavior_seq")
  @@index([academicYear, category])
}

model StudentYearlyBehaviorProjection {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear     Int
  startingScore    Int      @default(100)
  currentScore     Int      @default(100)
  totalDemerit     Int      @default(0)
  totalMerit       Int      @default(0)
  recordCount      Int      @default(0)
  lastCalculatedAt DateTime @default(now())

  @@unique([studentId, academicYear], map: "uk_student_yearly_behavior")
  @@index([academicYear, currentScore])
}

// -------------------------------------------------------------
// 3. Timezone-Strict Attendance & Authoritative 80% Schedule (Native Date)
// -------------------------------------------------------------

model ScheduledClassSession {
  id                    String               @id @default(cuid())
  offeringId            String
  offering              SubjectOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  businessDate          DateTime             @db.Date // Native PostgreSQL DATE
  periodNumber          Int                  // CHECK BETWEEN 1 AND 8
  sessionType           ScheduledSessionType @default(REGULAR)
  isEligibleDenominator Boolean              @default(true)
  cancellationReason    String?
  createdById           String
  createdBy             User                 @relation("CreatedScheduledSessions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now())

  periodAttendances     StudentPeriodAttendance[]

  @@unique([offeringId, businessDate, periodNumber], map: "uk_scheduled_class_session")
  @@index([businessDate, offeringId])
}

model StudentMorningAttendance {
  id            String                     @id @default(cuid())
  enrollmentId  String
  enrollment    StudentEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  businessDate  DateTime                   @db.Date // Native PostgreSQL DATE
  recordedAt    DateTime                   @default(now())
  status        StudentAttendanceStatus    @default(PRESENT)
  medicalCertId String?
  medicalCert   StudentMedicalCertificate? @relation(fields: [medicalCertId], references: [id], onDelete: Restrict)
  remarks       String?
  recordedById  String
  recordedBy    User                       @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, businessDate], map: "uk_student_morning_attendance")
  @@index([businessDate, status])
}

model StudentPeriodAttendance {
  id                 String                    @id @default(cuid())
  enrollmentId       String
  enrollment         StudentEnrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  scheduledSessionId String
  scheduledSession   ScheduledClassSession     @relation(fields: [scheduledSessionId], references: [id], onDelete: Restrict)
  status             StudentAttendanceStatus   @default(PRESENT)
  exemptionStatus    AttendanceExemptionStatus @default(NONE)
  medicalCertId      String?
  medicalCert        StudentMedicalCertificate? @relation(fields: [medicalCertId], references: [id], onDelete: Restrict)
  remarks            String?
  recordedById       String
  recordedBy         User                      @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt         DateTime                  @default(now())

  @@unique([enrollmentId, scheduledSessionId], map: "uk_student_period_attendance")
  @@index([scheduledSessionId, status])
}

model StudentMedicalCertificate {
  id                 String                     @id @default(cuid())
  studentId          String
  student            Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  startDate          DateTime                   @db.Date // Native PostgreSQL DATE
  endDate            DateTime                   @db.Date // Native PostgreSQL DATE
  hospitalName       String
  diagnosis          String?
  storageKey         String                     // Pure ASCII canonical path
  sha256             String                     // 64-character lowercase hex
  byteSize           BigInt                     // CHECK > 0
  isVerified         Boolean                    @default(false)
  verifiedById       String?
  verifiedBy         User?                      @relation("MedicalCertVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt         DateTime?
  
  morningAttendances StudentMorningAttendance[]
  periodAttendances  StudentPeriodAttendance[]
  createdAt          DateTime                   @default(now())

  @@index([studentId, startDate, endDate])
}

// -------------------------------------------------------------
// 4. Home Visit & SDQ (Direct Norms FK & Clean Attachments)
// -------------------------------------------------------------

model StudentHomeVisit {
  id                  String          @id @default(cuid())
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear        Int
  term                Int             // CHECK IN (1, 2)
  visitRound          Int             @default(1) // CHECK BETWEEN 1 AND 10
  visitDate           DateTime
  
  latitude            Float?
  longitude           Float?
  guardianIncomeMonth Decimal?        @db.Decimal(10, 2)
  dependentCount      Int             @default(0)
  
  houseCondition      String?
  roofMaterial        String?
  wallMaterial        String?
  floorMaterial       String?
  waterSource         String?
  toiletType          String?
  electricitySource   String?
  hasCar              Boolean         @default(false)
  hasMotorcycle       Boolean         @default(false)
  hasAirConditioner   Boolean         @default(false)
  agriculturalLandRai Float?          @default(0)
  
  distanceKm          Float?
  commuteMethod       String?
  commuteCostPerDay   Decimal?        @db.Decimal(8, 2)
  
  cctEstimatedPoverty CctPovertyLevel @default(NOT_POOR)
  cctPmtScore         Float?
  
  visitorTeacherId    String
  visitorTeacher      User            @relation(fields: [visitorTeacherId], references: [id], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([studentId, academicYear, term, visitRound], map: "uk_student_home_visit")
}

model SdqNormsRegistry {
  id                  String                 @id @default(cuid())
  instrumentVersion   String                 // "SDQ-TH-2558-V1"
  scoringVersion      String                 // "DOH-TH-NORMS-2015"
  evaluatorType       EvaluatorType          // TEACHER, PARENT, STUDENT
  targetAgeMin        Int                    // 11
  targetAgeMax        Int                    // 18
  reverseScoredItems  Json                   // [7, 11, 14, 21, 25]
  subscaleDefinitions Json
  cutoffsJson         Json
  isImmutable         Boolean                @default(false)
  
  evaluations         StudentSdqEvaluation[]
  createdAt           DateTime               @default(now())

  @@unique([instrumentVersion, scoringVersion, evaluatorType, targetAgeMin, targetAgeMax], map: "uk_sdq_norms")
}

model StudentSdqEvaluation {
  id                 String           @id @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear       Int
  term               Int              // CHECK IN (1, 2)
  evaluatorType      EvaluatorType
  
  normRegistryId     String
  normRegistry       SdqNormsRegistry @relation(fields: [normRegistryId], references: [id], onDelete: Restrict)
  
  emotionalScore     Int              // CHECK BETWEEN 0 AND 10
  conductScore       Int              // CHECK BETWEEN 0 AND 10
  hyperactivityScore Int              // CHECK BETWEEN 0 AND 10
  peerProblemScore   Int              // CHECK BETWEEN 0 AND 10
  prosocialScore     Int              // CHECK BETWEEN 0 AND 10
  totalDifficulties  Int              // CHECK total = sum(4 subscales)
  
  overallLevel       SdqLevel
  rawAnswersJson     Json
  evaluatorId        String
  evaluator          User             @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@unique([studentId, academicYear, term, evaluatorType], map: "uk_student_sdq_eval")
}

// -------------------------------------------------------------
// 5. Early Warning System & PDCA Intervention (1-to-Many Fix)
// -------------------------------------------------------------

model StudentRiskAssessment {
  id              String                   @id @default(cuid())
  studentId       String
  student         Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollmentId    String
  enrollment      StudentEnrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  academicYear    Int
  term            Int                      // CHECK IN (1, 2)
  evaluationCycle String
  riskLevel       RiskLevel
  riskScore       Float                    // CHECK BETWEEN 0.0 AND 100.0
  ruleVersion     String
  signalsJson     Json
  explanationJson Json
  calculatedAt    DateTime                 @default(now())
  
  triggeredCaseId String?
  triggeredCase   StudentInterventionCase? @relation("CaseRiskAssessments", fields: [triggeredCaseId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, ruleVersion, evaluationCycle], map: "uk_student_risk_cycle")
  @@index([academicYear, term, riskLevel])
}

model StudentInterventionCase {
  id                   String                  @id @default(cuid())
  caseNumber           String                  @unique
  studentId            String
  student              Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  title                String
  priority             CasePriority            @default(MEDIUM)
  status               CaseStatus              @default(OPEN)
  triggerReason        String
  actionPlan           String
  targetOutcome        String
  dueDate              DateTime?
  
  riskAssessments      StudentRiskAssessment[] @relation("CaseRiskAssessments")
  
  assignedToId         String
  assignedTo           User                    @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById          String
  createdBy            User                    @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  
  outcome              CaseOutcome             @default(PENDING)
  outcomeNotes         String?
  resolvedAt           DateTime?
  
  activities           InterventionActivity[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, priority])
  @@index([assignedToId])
}

model InterventionActivity {
  id               String                  @id @default(cuid())
  caseId           String
  case             StudentInterventionCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actionDate       DateTime
  activityTitle    String
  details          String
  nextFollowUpDate DateTime?
  recordedById     String
  recordedBy       User                    @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())

  @@index([caseId, actionDate])
}

// -------------------------------------------------------------
// 6. Custody, Audit & Manifest (Tombstone & Compensating Storage)
// -------------------------------------------------------------

model StudentAffairsAttachment {
  id              String               @id @default(cuid())
  entityType      AttachmentEntityType
  entityId        String
  category        AttachmentCategory   @default(HOME_VISIT_FAMILY)
  storageKey      String               // Pure ASCII canonical path
  sha256          String               // 64-character lowercase hex
  mimeType        String
  byteSize        BigInt               // CHECK > 0
  objectVersion   String               @default("v1")
  imageWidth      Int?
  imageHeight     Int?
  uploadedAt      DateTime             @default(now())
  uploadedById    String
  retentionUntil  DateTime?
  isQuarantined   Boolean              @default(false)
  
  // Tombstone Invariant (Triad CHECK Enforced)
  isTombstoned    Boolean              @default(false)
  tombstonedAt    DateTime?
  tombstonedById  String?
  tombstoneReason String?

  @@index([entityType, entityId])
  @@index([category])
}

model StudentAffairsAuditLog {
  id                String   @id @default(cuid())
  entityType        String
  entityId          String
  action            String
  actionVersion     String   @default("1.0")
  actorId           String
  actorIdSnapshot   String
  actorRoleSnapshot String
  correlationId     String
  requestId         String?
  source            String
  beforeHash        String?
  afterHash         String?
  payload           Json?
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
}

model CctExportManifest {
  id             String            @id @default(cuid())
  exportCode     String            @unique
  academicYear   Int
  term           Int               // CHECK IN (1, 2)
  criteriaJson   Json
  recordCount    Int               // CHECK >= 0
  storageKey     String
  payloadSha256  String
  byteSize       BigInt
  schemaVersion  String
  
  idempotencyKey String            @unique
  retryCount     Int               @default(0) // CHECK >= 0
  status         CctManifestStatus @default(PENDING_UPLOAD)
  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     User?             @relation("CctManifestVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  failureReason  String?
  
  createdById    String
  createdBy      User              @relation("CctManifestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([academicYear, term, status])
}

model StudentMeritNomination {
  id                 String                 @id @default(cuid())
  studentId          String
  student            Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear       Int
  term               Int
  awardCategory      String
  reason             String
  meritPointsScore   Int
  status             NominationStatus       @default(PENDING_REVIEW)
  
  reviewedById       String?
  reviewedBy         User?                  @relation("NominationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  rejectionReason    String?
  decisionNotes      String?
  
  certificateItemId  String?                @unique
  certificateItem    CertificateIssuedItem? @relation(fields: [certificateItemId], references: [id], onDelete: Restrict)
  createdAt          DateTime               @default(now())

  @@index([academicYear, status])
}




