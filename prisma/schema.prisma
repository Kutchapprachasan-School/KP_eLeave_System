generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id @default(cuid())
  name                String?
  email               String             @unique
  image               String?
  role                String             @default("TEACHER")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  emailVerified       Boolean            @default(false)
  lineUserId          String?
  position            String?
  subjectGroup        String?
  isApproved          Boolean            @default(false)
  signatureUrl        String?
  hasSignature        Boolean   @default(false)
  username            String?            @unique
  address             String?
  phoneNumber         String?
  level               String?
  bypassAttendance    Boolean            @default(false)
  faceConsent         Boolean            @default(false)
  faceConsentAt       DateTime?
  faceDescriptor      Json?
  faceProfileUrl      String?
  workShiftId         String?
  amssCredentials     AMSSCredentials?
  accounts            Account[]
  createdAttendances  Attendance[]       @relation("AttendanceCreatedBy")
  attendances         Attendance[]       @relation("UserAttendances")
  nonces              AttendanceNonce[]
  documentRecords     DocumentRecord[]
  createdRoutings     DocumentRouting[]  @relation("RoutingAssigner")
  assignedRoutings    DocumentRouting[]  @relation("RoutingAssignee")
  templates           DocumentTemplate[]
  createdIncomingDocs IncomingDocument[] @relation("IncomingDocCreator")
  leaveRequests       LeaveRequest[]
  uploadedPhotos      RepairPhoto[]      @relation("PhotoUploadedBy")
  requestsAssigned    RepairRequest[]    @relation("RequestAssignedTo")
  requestsCreated     RepairRequest[]    @relation("RequestCreatedBy")
  sessions            Session[]
  workShift           WorkShift?         @relation(fields: [workShiftId], references: [id])
  receiptsConfirmed   BudgetReceipt[]    @relation("ReceiptConfirmedBy")
  projectsLed         Project[]          @relation("ProjectLeader")
  activitiesResponsible ProjectActivity[] @relation("ActivityResponsible")
  expensesRequested   ActivityExpense[]  @relation("ExpenseRequestedBy")
  expensesApproved    ActivityExpense[]  @relation("ExpenseApprovedBy")
  reversalsCancelled  ExpenseReversal[]  @relation("ReversalCancelledBy")
  reversalsApproved   ExpenseReversal[]  @relation("ReversalApprovedBy")
  transfersRequested  BudgetTransfer[]   @relation("TransferRequestedBy")
  transfersApproved   BudgetTransfer[]   @relation("TransferApprovedBy")
  projectAttachmentsUploaded ProjectAttachment[] @relation("ProjectAttachmentUploadedBy")
  expenseAttachmentsUploaded ExpenseAttachment[] @relation("ExpenseAttachmentUploadedBy")
  driverProfile              DriverProfile?
  facilityReservations       FacilityReservation[] @relation("FacilityReservationsCreated")
  facilityApprovalSteps      FacilityApprovalStep[] @relation("FacilityApprovalApprover")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id             String    @id @default(cuid())
  userId         String
  type           String
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         String    @default("PENDING")
  documentUrl    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  execApproverId String?
  headApproverId String?
  rejectReason   String?
  extraFields    String?
  approvedSeq    Int?
  fiscalYear     Int?
  pendingSeq     Int?
  execApprovedAt DateTime?
  headApprovedAt DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments    FileAttachment[]
}

model SystemSettings {
  id                           String   @id @default("default")
  schoolName                   String   @default("ชื่อโรงเรียน")
  subheader                    String   @default("ระบบจัดการการลา")
  logoUrl                      String?
  footerText                   String   @default("© 2026 ระบบการลา")
  developerSecret              String   @default("admin1234")
  updatedAt                    DateTime @updatedAt
  lineChannelAccessToken       String?
  lineTargetGroupId            String?
  leaveRules                   String   @default("การลากิจต้องยื่นคำขอล่วงหน้าอย่างน้อย 3 วันทำการ\nการลาป่วยติดต่อกันเกิน 3 วัน ต้องแนบใบรับรองแพทย์\nระบบจะส่งแจ้งเตือนให้หัวหน้าหมวดของท่านพิจารณาเป็นลำดับแรก")
  requirePersonalAdvance       Boolean  @default(true)
  memoThresholdDays            Int      @default(15)
  memoThresholdTimes           Int      @default(6)
  defaultInspectorId           String?
  affiliation                  String   @default("สำนักงานเขตพื้นที่การศึกษามัธยมศึกษาอุดรธานี")
  actingDirectorTitle          String   @default("รักษาการในตำแหน่งผู้อำนวยการโรงเรียน")
  finalApproverUserIds         String   @default("")
  documentAdminUserIds         String   @default("")
  showActingDirectorTitle      Boolean  @default(true)
  enableLineNotify             Boolean  @default(true)
  googleDriveFormat            String   @default("PDF")
  pdfFont                      String   @default("Prompt")
  lastLeaveMode                String   @default("SAME")
  quotaExceededAction          String   @default("ALLOW_WITH_MEMO")
  rolePermissions              String   @default("{\"calendar\":[\"ADMIN\",\"DIRECTOR\",\"HR\",\"INSPECTOR\",\"TEACHER\"],\"reports\":[\"ADMIN\",\"DIRECTOR\",\"HR\",\"INSPECTOR\"],\"approvals\":[\"ADMIN\",\"DIRECTOR\",\"HR\",\"INSPECTOR\"],\"logs\":[\"ADMIN\"],\"backups\":[\"ADMIN\"],\"users\":[\"ADMIN\"],\"settings\":[\"ADMIN\"]}")
  attendanceLatitude           Float?
  attendanceLongitude          Float?
  attendanceRadius             Float?
  enableAdvancedKPI            Boolean  @default(true)
  enableAttendance             Boolean  @default(false)
  faceMatchThreshold           Float    @default(0.65)
  photoRetentionDays           Int?
  requireFaceScan              Boolean  @default(false)
  requireGeofence              Boolean  @default(false)
  requireLivenessCheck         Boolean  @default(false)
  enableDocument               Boolean  @default(false)
  timezone                     String   @default("Asia/Bangkok")
  iappApiKey                   String   @default("")
  googleDriveFolderId          String?
  googleDriveSecret            String?
  googleDriveUploadUrl         String?
  enableAutoPdfOnApproval      Boolean  @default(false)
  googleAppsScriptId           String?
  enableRepair                 Boolean  @default(false)
  enableRepairLineNotify       Boolean  @default(true)
  repairLineChannelAccessToken String?
  repairLineTargetGroupId      String?
  enableLeave                  Boolean  @default(true)
  enableTimetable              Boolean  @default(true)
  enableSubstitute             Boolean  @default(true)
  enableSupervision            Boolean  @default(true)
  enableExam                   Boolean  @default(true)
  enableCompetency             Boolean  @default(true)
  enableFacility               Boolean  @default(true)
  enableAcademicSettings       Boolean  @default(true)
  enableAmssSync               Boolean  @default(true)
  enableCertificate            Boolean  @default(true)
  enableBudget                 Boolean  @default(false)
  budgetAdminUserIds           String   @default("")
  enableStudentAffairs         Boolean  @default(false)
  enableStudentCouncil         Boolean  @default(false)
  enableAcademicPlanning       Boolean  @default(false)
  academicPlanningAllowedUserIds String @default("")
  documentManageMode           String   @default("DIRECT")
  timetablePeriodsPerDay       Int      @default(8)
  timetableStartTime           String   @default("08:30")
  timetablePeriodDuration      Int      @default(50)
  substitutePolicy             String   @default("DEPARTMENT")
  substituteWorkloadPenalty    Int      @default(10)
  enableSubstituteLineNotify   Boolean  @default(true)
  supervisionMinPerTerm        Int      @default(2)
  supervisionDirectorRatio     Int      @default(40)
  supervisionDeptRatio         Int      @default(40)
  supervisionSelfRatio         Int              @default(20)
  attachments                  FileAttachment[]
}

model LeaveConfig {
  id               String   @id @default(cuid())
  type             String   @unique
  name             String
  maxDaysPerYear   Int      @default(0)
  warningThreshold Int      @default(3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
}

model SystemLog {
  id          String   @id @default(cuid())
  actionType  String
  subsystem   String   @default("LEAVE")
  description String
  userId      String
  createdAt   DateTime @default(now())
  metadata    Json?
}

model SystemLogArchive {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  batchName   String
  logCount    Int      @default(0)
  logsData    Json
  createdAt   DateTime @default(now())
}

model LeaveArchive {
  id         String   @id @default(cuid())
  cycleLabel String
  cycleStart DateTime
  cycleEnd   DateTime
  data       String
  totalStaff Int      @default(0)
  totalDays  Int      @default(0)
  archivedBy String
  createdAt  DateTime @default(now())
}

model SystemBackup {
  id        String   @id @default(cuid())
  label     String
  data      String
  createdBy String
  createdAt DateTime @default(now())
}

model MemoSection {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  color             String             @default("#6366f1")
  icon              String             @default("Folder")
  sortOrder         Int                @default(0)
  documentConfigs   DocumentConfig?
  documentRecords   DocumentRecord[]
  templates         DocumentTemplate[]
  incomingDocuments IncomingDocument[]
}

model DocumentConfig {
  id              String       @id @default(cuid())
  docType         String
  memoSectionId   String?      @unique
  prefix          String       @default("")
  useThaiNumerals Boolean      @default(true)
  paddingDigits   Int          @default(1)
  yearFormat      String       @default("TH_BE")
  currentSeq      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memoSection     MemoSection? @relation(fields: [memoSectionId], references: [id], onDelete: Cascade)
}

model DocumentRecord {
  id             String             @id @default(cuid())
  docType        String
  memoSectionId  String?
  docNo          String?            @unique
  seqNo          Int?
  year           Int
  title          String
  to             String
  origin         String
  date           DateTime
  content        String
  signeeName     String
  signeePosition String
  enclosures     String?
  references     String?
  status         String             @default("DRAFT")
  cancelReason   String?
  isPinned       Boolean            @default(false)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  department     String?
  requester      String?
  attachmentName String?
  attachmentUrl  String?
  user           User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  memoSection    MemoSection?       @relation(fields: [memoSectionId], references: [id])
  outgoingLinks  DocumentRelation[] @relation("FromDocument")
  incomingLinks  DocumentRelation[] @relation("ToDocument")
  attachments    FileAttachment[]
}

model SigneePreset {
  id        String   @id @default(cuid())
  name      String
  position  String
  isCommon  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id             String       @id @default(cuid())
  name           String
  docType        String
  memoSectionId  String?
  title          String
  to             String
  origin         String
  content        String
  signeeName     String
  signeePosition String
  isPublic       Boolean      @default(true)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  memoSection    MemoSection? @relation(fields: [memoSectionId], references: [id])
}

model DocumentRelation {
  id        String         @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime       @default(now())
  fromDoc   DocumentRecord @relation("FromDocument", fields: [fromId], references: [id], onDelete: Cascade)
  toDoc     DocumentRecord @relation("ToDocument", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model WorkShift {
  id                String       @id @default(cuid())
  name              String
  startTime         String
  endTime           String
  lateThreshold     Int
  earlyOutThreshold Int
  isOvernight       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  attendances       Attendance[]
  users             User[]
}

model Attendance {
  id             String            @id @default(cuid())
  userId         String
  attendanceDate DateTime
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         AttendanceStatus
  workShiftId    String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      User?             @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  user           User              @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  workShift      WorkShift?        @relation(fields: [workShiftId], references: [id])
  logs           AttendanceLog[]
  photos         AttendancePhoto[]

  @@unique([userId, attendanceDate])
  @@index([userId])
  @@index([attendanceDate])
  @@index([status])
}

model AttendancePhoto {
  id               String     @id @default(cuid())
  attendanceId     String
  photoUrl         String
  faceMatchScore   Float?
  isLivenessPassed Boolean    @default(false)
  createdAt        DateTime   @default(now())
  attendance       Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model AttendanceLog {
  id               String     @id @default(cuid())
  attendanceId     String
  action           String
  timestamp        DateTime   @default(now())
  latitude         Float?
  longitude        Float?
  deviceInfo       String?
  verificationHash String?
  createdAt        DateTime   @default(now())
  attendance       Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model AttendanceNonce {
  id        String   @id @default(cuid())
  userId    String
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IncomingDocument {
  id            String            @id @default(cuid())
  receiveNo     String
  receiveDate   DateTime          @default(now())
  senderOrg     String
  docRefNo      String?
  title         String
  urgencyLevel  String            @default("NORMAL")
  amssLink      String?
  attachmentUrl String?
  memoSectionId String?
  status        String            @default("PENDING")
  note          String?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  amssOriginId  String?           @unique
  routingSteps  DocumentRouting[]
  createdBy     User              @relation("IncomingDocCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memoSection   MemoSection?      @relation(fields: [memoSectionId], references: [id])
  attachments   FileAttachment[]
}

model DocumentRouting {
  id                  String           @id @default(cuid())
  incomingDocId       String
  stepOrder           Int              @default(1)
  assigneeId          String
  assignedById        String
  status              String           @default("PENDING")
  resolution          String?
  note                String?
  deadline            DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  acknowledgedAt      DateTime?
  actionAttachmentUrl String?
  actionReport        String?
  assigneeName        String?
  directiveText       String?
  dueDate             DateTime?
  signatureUrl        String?
  standardDirective   String?
  assignedBy          User             @relation("RoutingAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  assignee            User             @relation("RoutingAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  incomingDoc         IncomingDocument @relation(fields: [incomingDocId], references: [id], onDelete: Cascade)

  @@index([incomingDocId])
  @@index([assigneeId, status])
}

model Holiday {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  name      String
  isCustom  Boolean  @default(false)
  isWorkday Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model AMSSCredentials {
  id               String    @id @default(cuid())
  userId           String    @unique
  username         String
  password         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  url              String    @default("")
  lastSyncAt       DateTime?
  sessionCookie    String?
  sessionExpiresAt DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RunningNumber {
  key     String @id
  year    Int
  current Int
}

model RepairRequest {
  id               String         @id @default(cuid())
  repairNo         String         @unique
  title            String
  description      String
  location         String
  urgency          RepairUrgency  @default(NORMAL)
  category         RepairCategory @default(OTHER)
  status           RepairStatus   @default(PENDING)
  version          Int            @default(1)
  requesterId      String
  assigneeId       String?
  resolutionNote   String?
  cost             Decimal?       @db.Decimal(10, 2)
  materialsUsed    String?
  cancelReason     String?
  expectedFinishAt DateTime?
  actualFinishAt   DateTime?
  slaStatus        SLAStatus?
  assignedAt       DateTime?
  finishedAt       DateTime?
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ratedAt          DateTime?
  rating           Int?
  ratingComment    String?
  photos           RepairPhoto[]
  assignee         User?          @relation("RequestAssignedTo", fields: [assigneeId], references: [id])
  requester        User           @relation("RequestCreatedBy", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([requesterId, status])
  @@index([updatedAt])
  @@index([id, version])
}

model RepairPhoto {
  id           String          @id @default(cuid())
  repairId     String
  photoType    RepairPhotoType
  mimeType     String
  fileSize     Int
  storageKey   String
  createdAt    DateTime        @default(now())
  uploadedById String
  repair       RepairRequest   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("PhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([repairId])
  @@index([repairId, photoType])
}

enum RepairUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RepairCategory {
  ELECTRICAL
  PLUMBING
  BUILDING
  IT
  FURNITURE
  AIR_CONDITIONER
  OTHER
}

enum RepairStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum RepairPhotoType {
  BEFORE
  AFTER
  ATTACHMENT
}

enum SLAStatus {
  ON_TIME
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_OUT
  ABSENT
  ON_LEAVE
  WORK_FROM_HOME
}

// ==========================================
// Supervision & SROP Models
// ==========================================

enum SupervisionStatus {
  SCHEDULED               // นัดหมายเรียบร้อย รอการนิเทศ
  WAITING_TEACHER_ACK     // ผู้นิเทศประเมินแล้ว รอครูรับทราบ/สะท้อนคิด
  WAITING_DIRECTOR_SIGN   // ครูรับทราบแล้ว รอ ผอ. ลงนามเห็นชอบ
  COMPLETED               // ผอ. ลงนามเสร็จสมบูรณ์
}

enum SupervisionType {
  ON_SITE        // นิเทศในห้องเรียนจริง
  ONLINE_VIDEO   // นิเทศออนไลน์ผ่านลิงก์ภายนอก
}

model SupervisionSession {
  id                  String             @id @default(cuid())
  schoolId            String
  academicYear        Int
  term                Int
  subjectCode         String
  subjectName         String
  gradeLevel          String
  departmentGroup     String
  dayOfWeek           Int
  periodNumber        Int
  scheduledDate       DateTime
  teacherId           String
  teacherName         String
  supervisorId        String
  supervisorName      String
  type                SupervisionType    @default(ON_SITE)
  lessonPlanUrl       String?
  videoUrl            String?
  rubricScores        Json?
  totalScore          Float?
  supervisorComment   String?            @db.Text
  teacherReflection   String?            @db.Text
  directorSignedBy    String?
  directorSignedAt    DateTime?
  directorComment     String?            @db.Text
  status              SupervisionStatus  @default(SCHEDULED)
  auditLogs           SupervisionAuditLog[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([schoolId, academicYear, term])
  @@index([teacherId, status])
  @@index([scheduledDate, dayOfWeek, periodNumber])
}

model SupervisionAuditLog {
  id          String             @id @default(cuid())
  sessionId   String
  session     SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actionBy    String
  actionType  String
  reason      String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([sessionId])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String   @default("PENDING")
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

enum TimetableVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentPolicyType {
  CENTRALIZED
  DEPARTMENT
  HYBRID
}

enum SubstituteWorkflowStatus {
  ASSIGNED
  ACKNOWLEDGED
  REJECTED
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  teachers    Teacher[]
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Teacher {
  id               String           @id @default(cuid())
  employeeCode     String           @unique
  prefix           String?
  firstName        String
  lastName         String
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id])
  maxWeeklyPeriods Int              @default(20)
  offerings        SubjectOffering[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Subject {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  credits      Float             @default(1.0)
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  offerings    SubjectOffering[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ClassRoom {
  id          String            @id @default(cuid())
  gradeLevel  Int
  roomNumber  Int
  name        String
  offerings   SubjectOffering[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([gradeLevel, roomNumber])
}

model Room {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  building    String?
  roomType    String          @default("REGULAR")
  slots       TimetableSlot[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SubjectOffering {
  id           String          @id @default(cuid())
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  teacherId    String
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  classRoomId  String
  classRoom    ClassRoom       @relation(fields: [classRoomId], references: [id])
  academicYear Int
  term         Int
  slots        TimetableSlot[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([subjectId, teacherId, classRoomId, academicYear, term])
  @@index([academicYear, term])
}

model TimetableVersion {
  id                 String                 @id @default(cuid())
  schoolId           String
  academicYear       Int
  term               Int
  versionName        String
  status             TimetableVersionStatus @default(DRAFT)
  isCurrentPublished Boolean                @default(false)
  slots              TimetableSlot[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([schoolId, academicYear, term, status])
}

model TimetableSlot {
  id                 String              @id @default(cuid())
  timetableVersionId String
  timetableVersion   TimetableVersion    @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)
  offeringId         String
  offering           SubjectOffering     @relation(fields: [offeringId], references: [id])
  roomId             String
  room               Room                @relation(fields: [roomId], references: [id])
  dayOfWeek          Int
  periodNumber       Int
  recommendationRuns RecommendationRun[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([timetableVersionId, offeringId, dayOfWeek, periodNumber])
  @@unique([timetableVersionId, roomId, dayOfWeek, periodNumber])
}

model SchoolConfig {
  id               String               @id @default(cuid())
  schoolId         String               @unique
  assignmentPolicy AssignmentPolicyType @default(DEPARTMENT)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model SubstituteWorkflow {
  id                String                   @id @default(cuid())
  leaveRequestId    String
  timetableSlotId   String
  date              DateTime
  assignedTeacherId String
  assignedBy        String
  status            SubstituteWorkflowStatus @default(ASSIGNED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([leaveRequestId, date])
}

model RecommendationRun {
  id              String        @id @default(cuid())
  leaveRequestId  String
  timetableSlotId String
  policy          String
  candidatesJson  String
  createdAt       DateTime      @default(now())
  timetableSlot   TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@index([timetableSlotId])
}

// ==========================================
// ACADEMIC & GENERAL SUBSYSTEMS: FACILITIES & VEHICLE CATALOG
// ==========================================

enum ResourceType {
  MEETING_ROOM
  CLASSROOM
  LABORATORY
  VEHICLE
  EQUIPMENT
  OTHER
}

enum ResourceStatus {
  AVAILABLE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  IN_USE
  COMPLETED
}

enum AssignmentTargetType {
  RESOURCE
  DRIVER
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum RoomLayoutType {
  THEATER
  CLASSROOM
  U_SHAPE
  BANQUET
  BOARDROOM
  HOLLOW_SQUARE
  CUSTOM
}

enum VehicleMissionType {
  OFFICIAL_MEETING
  STUDENT_COMPETITION
  FIELD_TRIP
  COMMUNITY_SERVICE
  OTHER
}

model FacilityResource {
  id             String                          @id @default(cuid())
  code           String                          @unique
  name           String
  type           ResourceType
  capacity       Int?
  location       String?
  description    String?                         @db.Text
  status         ResourceStatus                  @default(AVAILABLE)
  vehicleProfile VehicleProfile?
  roomProfile    RoomProfile?
  reservations   FacilityReservation[]
  assignments    ReservationResourceAssignment[]
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@index([type, status])
}

model RoomProfile {
  id                  String           @id @default(cuid())
  resourceId          String           @unique
  resource            FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  floor               String?
  hasProjector        Boolean          @default(true)
  hasSoundSystem      Boolean          @default(true)
  hasVideoConference  Boolean          @default(false)
  airConditionerCount Int              @default(2)
}

model VehicleProfile {
  id              String           @id @default(cuid())
  resourceId      String           @unique
  resource        FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  licensePlate    String           @unique
  brand           String?
  model           String?
  fuelType        String           @default("DIESEL")
  seatCapacity    Int              @default(12)
  currentOdometer Float            @default(0)
}

model DriverProfile {
  id                 String                          @id @default(cuid())
  userId             String                          @unique
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String
  licenseExpiry      DateTime?
  phoneNumber        String
  isActive           Boolean                         @default(true)
  assignments        ReservationResourceAssignment[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([isActive])
}

model FacilityApprovalPolicy {
  id                String       @id @default(cuid())
  moduleType        ResourceType
  stepNo            Int
  roleRequired      String
  title             String
  slaHours          Int          @default(24)
  bufferHoursBefore Int          @default(6)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([moduleType, stepNo])
}

model FacilityReservation {
  id               String                          @id @default(cuid())
  bookingNumber    String?                         @unique
  resourceId       String
  resource         FacilityResource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reservedByUserId String
  reservedByUser   User                            @relation("FacilityReservationsCreated", fields: [reservedByUserId], references: [id])
  consumerModule   String                          @default("MANUAL")
  title            String
  purpose          String?                         @db.Text
  startAt          DateTime
  endAt            DateTime
  expiresAt        DateTime?
  attendeeCount    Int?
  department       String?
  contactPhone     String?
  status           ReservationStatus               @default(PENDING)
  currentStep      Int                             @default(1)
  totalSteps       Int                             @default(2)
  rejectionReason  String?
  attachments      Json?
  approvalSteps    FacilityApprovalStep[]
  assignments      ReservationResourceAssignment[]
  roomDetails      RoomReservationDetail?
  vehicleDetails   VehicleReservationDetail?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([resourceId, status, startAt, endAt])
  @@index([reservedByUserId, status])
}

model ReservationResourceAssignment {
  id              String               @id @default(cuid())
  reservationId   String
  reservation     FacilityReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  targetType      AssignmentTargetType
  resourceId      String?
  resource        FacilityResource?    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  driverProfileId String?
  driverProfile   DriverProfile?       @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime
  status          ReservationStatus    @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([resourceId, status, startAt, endAt])
  @@index([driverProfileId, status, startAt, endAt])
}

model FacilityApprovalStep {
  id             String              @id @default(cuid())
  reservationId  String
  reservation    FacilityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stepNo         Int
  roleRequired   String
  title          String
  status         ApprovalStepStatus  @default(PENDING)
  approverUserId String?
  approver       User?               @relation("FacilityApprovalApprover", fields: [approverUserId], references: [id])
  comment        String?             @db.Text
  actedAt        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([reservationId, stepNo])
  @@index([approverUserId, status])
}

model RoomReservationDetail {
  id               String              @id @default(cuid())
  reservationId    String              @unique
  reservation      FacilityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  layoutType       RoomLayoutType      @default(THEATER)
  layoutNotes      String?             @db.Text
  audioVisualNotes String?             @db.Text
  cateringNotes    String?             @db.Text
  requireAirCon    Boolean             @default(true)
}

model VehicleReservationDetail {
  id                 String              @id @default(cuid())
  reservationId      String              @unique
  reservation        FacilityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  missionType        VehicleMissionType  @default(OFFICIAL_MEETING)
  origin             String              @default("โรงเรียนกุดจับประชาสรรค์")
  destination        String
  teacherCount       Int                 @default(1)
  studentCount       Int                 @default(0)
  passengerListNotes String?             @db.Text
  driverAssignedAt   DateTime?
  startMileage       Float?
  endMileage         Float?
  fuelCost           Float?
  tripNotes          String?             @db.Text
}

model SignatureTokenLog {
  jti        String    @id @unique
  userId     String
  docId      String
  purpose    String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
  expiresAt  DateTime

  @@index([userId, docId])
  @@index([expiresAt])
}

// ==========================================
// ACADEMIC SUBSYSTEMS: EXAM SCHEDULING
// ==========================================

enum ExamTerm {
  MIDTERM
  FINAL
  SPECIAL
}

model ExamPeriod {
  id            String              @id @default(cuid())
  academicYear  Int
  term          Int                 // 1 or 2
  examType      ExamTerm
  title         String              // e.g., "การสอบกลางภาคเรียนที่ 1/2026"
  startDate     DateTime
  endDate       DateTime
  desksPerRoom  Int                 @default(30)
  isActive      Boolean             @default(true)
  examSlots     ExamSubjectSlot[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ExamSubjectSlot {
  id            String                @id @default(cuid())
  examPeriodId  String
  examPeriod    ExamPeriod            @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  subjectCode   String
  subjectName   String
  gradeLevel    String                // e.g., "ม.1"
  examDate      DateTime
  startTime     String                // e.g., "08:30"
  endTime       String                // e.g., "10:00"
  durationMins  Int                   @default(90)
  proctors      ExamProctorAssignment[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ExamProctorAssignment {
  id            String          @id @default(cuid())
  slotId        String
  slot          ExamSubjectSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  teacherId     String
  teacherName   String
  roomId        String
  roomName      String
  role          String          @default("MAIN_PROCTOR") // MAIN_PROCTOR, ASSISTANT
  createdAt     DateTime        @default(now())

  @@index([teacherId, slotId])
}

// ==========================================
// ACADEMIC SUBSYSTEMS: PA & COMPETENCY
// ==========================================

model PaTargetConfig {
  id                  String   @id @default(cuid())
  academicYear        Int      @unique
  targetPdHours       Int      @default(20) // เกณฑ์ชั่วโมง PD ขั้นต่ำต่อปี
  competencyMaxScore  Int      @default(5)  // คะแนนเต็มแต่ละด้าน (1-5)
  description         String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaAgreement {
  id                  String                 @id @default(cuid())
  academicYear        Int
  teacherId           String
  teacherName         String
  departmentId        String
  agreementTitle      String
  status              String                 @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED
  evaluations         CompetencyEvaluation[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([academicYear, teacherId])
}

model PdHourLog {
  id            String   @id @default(cuid())
  teacherId     String
  academicYear  Int
  topic         String
  organizer     String
  hours         Float
  completedDate DateTime
  certificateUrl String?
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model CompetencyEvaluation {
  id              String      @id @default(cuid())
  paAgreementId   String
  paAgreement     PaAgreement @relation(fields: [paAgreementId], references: [id], onDelete: Cascade)
  evaluatorId     String
  evaluatorRole   String      // SUPERVISOR, DIRECTOR, PEER
  dimension1Score Int         // การจัดการเรียนรู้
  dimension2Score Int         // การบริหารจัดการชั้นเรียน
  dimension3Score Int         // การพัฒนาตนเองและวิชาชีพ
  dimension4Score Int         // การทำงานร่วมกับชุมชน
  dimension5Score Int         // จริยธรรมและวิทยฐานะ
  comments        String?     @db.Text
  evaluatedAt     DateTime    @default(now())
}

// ==========================================
// ACADEMIC PLANNING PLATFORM (CONTROL PLANE 100/100)
// ==========================================

enum PlanningStatus {
  SETUP
  IN_PLANNING
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model PlanningSession {
  id                  String           @id @default(cuid())
  name                String           // "การวางแผนวิชาการ ภาคเรียนที่ 1/2569"
  academicYear        Int              // 2569
  term                Int              // 1
  curriculumVersionId String?
  status              PlanningStatus   @default(SETUP)
  readinessScore      Float            @default(0.0) // 0.00 - 100.00%
  approvalSteps       ApprovalStep[]
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([academicYear, term])
}

model ApprovalStep {
  id                String          @id @default(cuid())
  planningSessionId String
  planningSession   PlanningSession @relation(fields: [planningSessionId], references: [id], onDelete: Cascade)
  stepOrder         Int             // 1: Dept Review, 2: Academic Review, 3: Director
  roleRequired      String          // "HEAD_OF_DEPT", "ACADEMIC_DIRECTOR", "SCHOOL_DIRECTOR"
  status            String          @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  comment           String?
  approvedById      String?
  approvedAt        DateTime?
}

model ReadinessIndicator {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "RULE_OFFERING_COVERAGE"
  name        String   // "ความครอบคลุมการเปิดรายวิชาทุกห้องเรียน"
  weight      Float    // e.g., 25.0 (%)
  enabled     Boolean  @default(true)
  expression  String   // e.g., "offeringPercent >= 100"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApprovalWorkflow {
  id          String          @id @default(cuid())
  name        String          @unique // e.g., "Standard 3-Stage Approval"
  isDefault   Boolean         @default(true)
  stages      ApprovalStage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ApprovalStage {
  id          String           @id @default(cuid())
  workflowId  String
  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stageOrder  Int
  stageName   String           // "หัวหน้ากลุ่มสาระการเรียนรู้", "รองผู้อำนวยการฝ่ายวิชาการ", "ผู้อำนวยการโรงเรียน"
  roleName    String           // "HEAD_OF_DEPT", "ACADEMIC_DIRECTOR", "SCHOOL_DIRECTOR"
  isMandatory Boolean          @default(true)
}

model AcademicCalendar {
  id           String          @id @default(cuid())
  academicYear Int             @unique
  term         Int             @default(1)
  title        String          // "ปฏิทินวิชาการ 2569"
  events       AcademicEvent[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model AcademicEvent {
  id                 String           @id @default(cuid())
  calendarId         String
  calendar           AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  eventType          String           // "OPENING_DAY", "EXAM_WEEK", "HOLIDAY", "SCOUT_CAMP", "SPORTS_DAY", "PA_OBSERVATION"
  title              String
  startDate          DateTime
  endDate            DateTime
  locksTimetable     Boolean          @default(false)
  locksSupervision   Boolean          @default(false)
  description        String?
  createdAt          DateTime         @default(now())
}

model ResourceItem {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String                // "ห้องปฏิบัติการเคมี 1", "หอประชุมใหญ่"
  resourceType String                // "SCIENCE_LAB", "COMPUTER_LAB", "MUSIC_ROOM", "GYM", "STADIUM", "BUS", "AUDITORIUM"
  capacity     Int                   @default(40)
  location     String?
  reservations ResourceReservation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ResourceReservation {
  id           String       @id @default(cuid())
  resourceId   String
  resource     ResourceItem @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reservedBy   String
  reservedFor  String       // e.g., "ทดลองปฏิกิริยาเคมี ม.5/1"
  startTime    DateTime
  endTime      DateTime
  status       String       @default("APPROVED") // PENDING, APPROVED, CANCELLED
  createdAt    DateTime     @default(now())
}

model PlanningSandboxScenario {
  id           String   @id @default(cuid())
  name         String   // e.g., "Scenario A: เพิ่มคาบเน้นคณิต-วิทย์"
  description  String?
  academicYear Int
  term         Int
  isPublished  Boolean  @default(false)
  payloadJson  Json     // Sandbox delta parameters
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CourseWeightFactor {
  id                String   @id @default(cuid())
  subjectCode       String   @unique
  preparationWeight Float    @default(1.0)
  labWeight          Float    @default(1.1)
  assessmentWeight Float    @default(1.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==========================================
// 🏛️ PROJECT PLANNING & BUDGET LEDGER SYSTEM
// ==========================================

model FiscalYear {
  id            String           @id @default(cuid())
  year          Int              @unique(map: "uk_fiscal_year_year") // e.g. 2569
  title         String           // e.g. "ปีงบประมาณ พ.ศ. 2569"
  startDate     DateTime         // 1 ต.ค.
  endDate       DateTime         // 30 ก.ย.
  status        String           @default("ACTIVE") // DRAFT, ACTIVE, CLOSED
  isArchived    Boolean          @default(false)
  budgetSources BudgetSource[]
  projects      Project[]
  transfers     BudgetTransfer[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model BudgetSource {
  id                 String          @id @default(cuid())
  fiscalYearId       String
  fiscalYear         FiscalYear      @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  code               String          // e.g. "SUBSIDY_PER_HEAD", "OPERATING_FUND"
  name               String          // e.g. "เงินอุดหนุนรายหัว", "เงินรายได้สถานศึกษา"
  totalPlannedAmount Decimal         @default(0) @db.Decimal(19, 4)
  tranches           BudgetTranche[]
  projects           Project[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([fiscalYearId, code], map: "uk_budget_source_fy_code")
  @@index([fiscalYearId], map: "idx_budget_source_fy")
}

model BudgetTranche {
  id                  String                      @id @default(cuid())
  budgetSourceId      String
  budgetSource        BudgetSource                @relation(fields: [budgetSourceId], references: [id], onDelete: Restrict)
  trancheNo           Int                         // 1, 2, 3, 4
  name                String                      // e.g. "ภาคเรียนที่ 1 (รอบ 70%)"
  academicYear        Int                         // ปีการศึกษา e.g. 2569
  semester            Int                         // ภาคเรียน 1 หรือ 2
  expectedStartDate   DateTime?
  expectedEndDate     DateTime?
  plannedAmount       Decimal                     @default(0) @db.Decimal(19, 4)
  isClosed            Boolean                     @default(false)
  receipts            BudgetReceipt[]
  activityAllocations ActivityTrancheAllocation[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([budgetSourceId, trancheNo], map: "uk_tranche_src_no")
  @@index([budgetSourceId], map: "idx_tranche_src")
}

model BudgetReceipt {
  id                String        @id @default(cuid())
  idempotencyKey    String        @unique(map: "uk_receipt_idempotency")
  budgetTrancheId   String
  budgetTranche     BudgetTranche @relation(fields: [budgetTrancheId], references: [id], onDelete: Restrict)
  amount            Decimal       @db.Decimal(19, 4)
  receivedDate      DateTime
  documentRef       String?       // เลขที่หนังสือแจ้งจัดสรร/ใบนำฝาก
  bankStatement     String?       // เลขที่รายการเดินบัญชี
  notes             String?
  confirmedByUserId String
  confirmedByUser   User          @relation("ReceiptConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([budgetTrancheId], map: "idx_receipt_tranche")
  @@index([confirmedByUserId], map: "idx_receipt_confirmed_by")
  @@index([receivedDate], map: "idx_receipt_received_date")
}

model Project {
  id                 String              @id @default(cuid())
  fiscalYearId       String
  fiscalYear         FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  budgetSourceId     String
  budgetSource       BudgetSource        @relation(fields: [budgetSourceId], references: [id], onDelete: Restrict)
  departmentName     String?             // e.g. "ฝ่ายบริหารงานวิชาการ", "กลุ่มสาระการเรียนรู้วิทยาศาสตร์ฯ"
  leaderUserId       String
  leaderUser         User                @relation("ProjectLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  leaderName         String              @default("") // Immutable snapshot of User.name at creation time; leaderUserId is authoritative source of truth
  code               String              // e.g. "PRJ-2569-001"
  name               String              // ชื่อโครงการ
  targetAcademicYear Int                 // ปีการศึกษาเป้าหมาย e.g. 2569
  allocatedAmount    Decimal             @default(0) @db.Decimal(19, 4)
  status             String              @default("APPROVED") // DRAFT, APPROVED, IN_PROGRESS, COMPLETED, CANCELLED
  activities         ProjectActivity[]
  attachments        ProjectAttachment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([fiscalYearId, code], map: "uk_project_fy_code")
  @@index([fiscalYearId], map: "idx_project_fy")
  @@index([budgetSourceId], map: "idx_project_budget_source")
  @@index([leaderUserId], map: "idx_project_leader")
  @@index([status], map: "idx_project_status")
}

model ProjectActivity {
  id                 String                      @id @default(cuid())
  projectId          String
  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  responsibleUserId  String
  responsibleUser    User                        @relation("ActivityResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  activityNo         Int                         // 1, 2, 3...
  name               String                      // ชื่อกิจกรรม
  allocatedAmount    Decimal                     @default(0) @db.Decimal(19, 4)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  status             String                      @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, CANCELLED
  trancheAllocations ActivityTrancheAllocation[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([projectId, activityNo], map: "uk_activity_project_no")
  @@index([projectId, status], map: "idx_activity_project_status")
  @@index([responsibleUserId], map: "idx_activity_responsible")
}

model ActivityTrancheAllocation {
  id              String            @id @default(cuid())
  activityId      String
  activity        ProjectActivity   @relation(fields: [activityId], references: [id], onDelete: Restrict)
  budgetTrancheId String
  budgetTranche   BudgetTranche     @relation(fields: [budgetTrancheId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal           @db.Decimal(19, 4)
  expenses        ActivityExpense[]
  transfersFrom   BudgetTransfer[]  @relation("TransferFrom")
  transfersTo     BudgetTransfer[]  @relation("TransferTo")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([activityId, budgetTrancheId], map: "uk_alloc_activity_tranche")
  @@index([budgetTrancheId], map: "idx_alloc_tranche")
  @@index([activityId], map: "idx_alloc_activity")
}

model ActivityExpense {
  id                String                    @id @default(cuid())
  idempotencyKey    String                    @unique(map: "uk_expense_idempotency")
  allocationId      String
  allocation        ActivityTrancheAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedByUser   User                      @relation("ExpenseRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId  String?
  approvedByUser    User?                     @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  expenseDate       DateTime
  title             String
  amount            Decimal                   @db.Decimal(19, 4)
  receiptNo         String?
  status            String                    @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED, REVERSED
  rejectedReason    String?
  submittedAt       DateTime?                 @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  attachments       ExpenseAttachment[]
  reversal          ExpenseReversal?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([allocationId, status], map: "idx_expense_alloc_status")
  @@index([expenseDate], map: "idx_expense_date")
  @@index([requestedByUserId], map: "idx_expense_requested_by")
  @@index([status], map: "idx_expense_status")
}

model ExpenseReversal {
  id                String                    @id @default(cuid())
  originalExpenseId String                    @unique(map: "uk_reversal_original_expense")
  originalExpense   ActivityExpense           @relation(fields: [originalExpenseId], references: [id], onDelete: Restrict)
  amount            Decimal                   @db.Decimal(19, 4)
  reason            String
  cancelledByUserId String
  cancelledByUser   User                      @relation("ReversalCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  approvedByUserId  String?
  approvedByUser    User?                     @relation("ReversalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  status            String                    @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED
  approvedAt        DateTime?                 @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([cancelledByUserId], map: "idx_reversal_cancelled_by")
}

model BudgetTransfer {
  id                String                    @id @default(cuid())
  fiscalYearId      String
  fiscalYear        FiscalYear                @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  fromAllocationId  String
  fromAllocation    ActivityTrancheAllocation @relation("TransferFrom", fields: [fromAllocationId], references: [id], onDelete: Restrict)
  toAllocationId    String
  toAllocation      ActivityTrancheAllocation @relation("TransferTo", fields: [toAllocationId], references: [id], onDelete: Restrict)
  amount            Decimal                   @db.Decimal(19, 4)
  reason            String
  requestedByUserId String
  requestedByUser   User                      @relation("TransferRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId  String?
  approvedByUser    User?                     @relation("TransferApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  status            String                    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([fiscalYearId], map: "idx_transfer_fiscal_year")
  @@index([fromAllocationId], map: "idx_transfer_from_alloc")
  @@index([toAllocationId], map: "idx_transfer_to_alloc")
}

model AuditLog {
  id        String   @id @default(cuid())
  tableName String
  recordId  String
  action    String   // "CREATE", "UPDATE", "APPROVE", "REVERSE", "TRANSFER"
  field     String?
  oldValue  String?
  newValue  String?
  changedBy String   // userId
  reason    String?
  createdAt DateTime @default(now())

  @@index([tableName, recordId], map: "idx_audit_table_record")
  @@index([changedBy], map: "idx_audit_changed_by")
  @@index([createdAt], map: "idx_audit_created_at")
}

model ProjectAttachment {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageProvider  String   // "LOCAL", "SUPABASE_STORAGE", "GOOGLE_DRIVE_LINK"
  objectKey        String   // file path or external URL
  originalFileName String
  mimeType         String?
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User     @relation("ProjectAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([projectId], map: "idx_proj_attach_proj")
  @@index([uploadedByUserId], map: "idx_proj_attach_user")
}

model ExpenseAttachment {
  id               String          @id @default(cuid())
  expenseId        String
  expense          ActivityExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  storageProvider  String          // "LOCAL", "SUPABASE_STORAGE", "GOOGLE_DRIVE_LINK"
  objectKey        String          // file path or external URL
  originalFileName String
  mimeType         String?
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User            @relation("ExpenseAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())

  @@index([expenseId], map: "idx_exp_attach_exp")
  @@index([uploadedByUserId], map: "idx_exp_attach_user")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cloudflare R2 Universal Storage & Migration Models (Production-Grade)
// ─────────────────────────────────────────────────────────────────────────────

enum AccessLevel {
  PRIVATE
  PUBLIC
}

enum StorageProviderType {
  R2
  LOCAL
  SUPABASE
  NEON
}

enum UploadStatus {
  PENDING
  COMMITTED
  ABORTED
}

enum MigrationStatus {
  PENDING
  UPLOADED
  VERIFIED
  CUTOVER
  FAILED
}

model FileAttachment {
  id                 String              @id @default(cuid())
  storageProvider    StorageProviderType @default(R2)
  objectKey          String              @unique
  originalFileName   String
  mimeType           String
  fileSize           BigInt
  checksumSha256     String
  accessLevel        AccessLevel         @default(PRIVATE)

  // Explicit Relations with Restrict Integrity (Guards Official Government Records)
  leaveRequestId     String?
  leaveRequest       LeaveRequest?       @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  incomingDocumentId String?
  incomingDocument   IncomingDocument?   @relation(fields: [incomingDocumentId], references: [id], onDelete: Restrict)

  documentRecordId   String?
  documentRecord     DocumentRecord?     @relation(fields: [documentRecordId], references: [id], onDelete: Restrict)

  systemSettingsId   String?
  systemSettings     SystemSettings?     @relation(fields: [systemSettingsId], references: [id], onDelete: Restrict)

  uploadLog          StorageUploadLog?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([leaveRequestId])
  @@index([incomingDocumentId])
  @@index([documentRecordId])
  @@index([systemSettingsId])
  @@index([objectKey])
}

model StorageUploadLog {
  id               String          @id @default(cuid())
  objectKey        String          @unique
  bucket           String
  originalFileName String
  mimeType         String
  fileSize         BigInt
  checksumSha256   String
  status           UploadStatus    @default(PENDING)
  uploadedBy       String
  fileAttachmentId String?         @unique
  fileAttachment   FileAttachment? @relation(fields: [fileAttachmentId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  committedAt      DateTime?
  abortedAt        DateTime?
  error            String?

  @@index([status, createdAt])
}

model StorageMigrationLog {
  id                   String          @id @default(cuid())
  sourceTable          String
  sourceRecordId       String
  sourceField          String
  attachmentSlot       Int             @default(0)
  attachmentId         String?
  sourceChecksumSha256 String
  destinationObjectKey String?
  destChecksumSha256   String?
  status               MigrationStatus @default(PENDING)
  errorMessage         String?
  migratedAt           DateTime?
  verifiedAt           DateTime?
  cutoverAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([sourceTable, sourceRecordId, sourceField, attachmentSlot])
  @@index([status])
}

